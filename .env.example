# Copy to .env and fill in. .env is gitignored  never commit a real key.

# Groq is the primary provider. A free key takes a minute and needs no card:
# console.groq.com/keys
GROQ_API_KEY=gsk_your_key_here

# Optional fallback, tried when Groq is rate limited or down.
OPENROUTER_API_KEY=sk-or-v1-your-key-here

# Optional. Leave empty and each provider picks its own default, which is what you
# want  a model slug belongs to one provider, and naming a paid one here means a
# zero-balance account starts answering 402.
AI_REVIEW_MODEL=

# Optional CI-gate thresholds
AI_REVIEW_MAX_CRITICAL=0
AI_REVIEW_MAX_HIGH=3
