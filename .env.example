# Copy to .env and fill in. .env is gitignored — never commit a real key.
OPENROUTER_API_KEY=sk-or-v1-your-key-here

# Optional: override the model. Default is a strong, low-cost model.
# Free options (may rate-limit): openai/gpt-oss-20b:free, google/gemma-4-31b-it:free
AIQA_MODEL=deepseek/deepseek-chat-v3.1

# Optional CI-gate thresholds
AIQA_MAX_CRITICAL=0
AIQA_MAX_HIGH=3
