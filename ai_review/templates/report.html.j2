<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>Code review · {{ r.project }}</title>
<style>
  :root{
    --bg:#f8f7ff; --panel:#ffffff; --panel2:#f3f1ff; --line:#e6e2f7;
    --text:#2b2545; --muted:#635d87; --accent:#6c5ce7; --accent2:#9381ff;
  }
  *{box-sizing:border-box;margin:0;padding:0}
  body{background:radial-gradient(1200px 600px at 82% -10%,rgba(147,129,255,.20),transparent),
       radial-gradient(1000px 520px at -8% 8%,rgba(255,216,190,.35),transparent),var(--bg);
       color:var(--text);font:15px/1.6 -apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,Helvetica,Arial,sans-serif;
       min-height:100vh;padding:32px 20px}
  .wrap{max-width:1040px;margin:0 auto}
  .top{display:flex;flex-wrap:wrap;align-items:center;justify-content:space-between;gap:16px;margin-bottom:28px}
  .brand{display:flex;align-items:center;gap:12px}
  .logo{width:40px;height:40px;border-radius:11px;background:linear-gradient(135deg,var(--accent),var(--accent2));
        display:grid;place-items:center;font-weight:800;color:#0b0e14}
  h1{font-size:20px;font-weight:700;letter-spacing:-.02em}
  .sub{color:var(--muted);font-size:13px}
  .meta{color:var(--muted);font-size:12.5px;text-align:right}
  .meta code{color:var(--accent)}
  .cards{display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));gap:14px;margin-bottom:26px}
  .card{background:var(--panel);border:1px solid var(--line);border-radius:14px;padding:18px}
  .card .n{font-size:30px;font-weight:800;letter-spacing:-.03em}
  .card .l{color:var(--muted);font-size:12px;text-transform:uppercase;letter-spacing:.08em;margin-top:2px}
  .gate{display:inline-flex;align-items:center;gap:8px;padding:5px 12px;border-radius:999px;font-size:12.5px;font-weight:600}
  .gate.pass{background:rgba(46,163,107,.14);color:#1f8f5f;border:1px solid rgba(46,163,107,.35)}
  .gate.fail{background:rgba(214,72,106,.12);color:#c23258;border:1px solid rgba(214,72,106,.35)}
  .bar{display:flex;height:10px;border-radius:6px;overflow:hidden;margin:14px 0 26px;border:1px solid var(--line)}
  .bar span{display:block}
  .legend{display:flex;flex-wrap:wrap;gap:14px;margin:-14px 0 26px;font-size:12.5px;color:var(--muted)}
  .dot{display:inline-block;width:9px;height:9px;border-radius:50%;margin-right:6px;vertical-align:middle}
  h2{font-size:15px;text-transform:uppercase;letter-spacing:.1em;color:var(--muted);margin:26px 0 12px}
  .file{background:var(--panel);border:1px solid var(--line);border-radius:14px;margin-bottom:16px;overflow:hidden}
  .file-h{padding:14px 18px;border-bottom:1px solid var(--line);display:flex;justify-content:space-between;gap:10px;align-items:center}
  .file-h .path{font-family:ui-monospace,SFMono-Regular,Menlo,monospace;font-size:13.5px;color:var(--accent)}
  .file-h .fsum{color:var(--muted);font-size:12.5px}
  .finding{padding:14px 18px;border-bottom:1px solid var(--line)}
  .finding:last-child{border-bottom:none}
  .finding-h{display:flex;align-items:center;gap:10px;flex-wrap:wrap}
  .sev{font-size:11px;font-weight:800;text-transform:uppercase;letter-spacing:.05em;padding:3px 9px;border-radius:6px;color:#0b0e14}
  .cat{font-size:11px;color:var(--muted);border:1px solid var(--line);padding:2px 8px;border-radius:6px}
  .loc{font-family:ui-monospace,monospace;font-size:12px;color:var(--muted);margin-left:auto}
  .ftitle{font-weight:650;font-size:14.5px;flex-basis:100%;margin-top:4px}
  .detail{color:#43406a;font-size:13.5px;margin-top:6px}
  .rec{color:#1f7a52;font-size:13px;margin-top:6px}
  .rec b{color:#178a56}
  .tests{padding:14px 18px;background:var(--panel2)}
  .test{margin-bottom:14px}
  .test .tt{font-weight:650}
  pre{background:#f5f3ff;border:1px solid var(--line);border-radius:9px;padding:12px;overflow:auto;
      font-family:ui-monospace,monospace;font-size:12.5px;color:#3a3560;margin-top:8px}
  .empty{color:var(--muted);font-style:italic;padding:14px 18px}
  footer{margin-top:34px;color:var(--muted);font-size:12.5px;text-align:center}
  a{color:var(--accent);text-decoration:none}
</style>
</head>
<body>
<div class="wrap">

  <div class="top">
    <div class="brand">
      <div class="logo">◆</div>
      <div>
        <h1>Code review report</h1>
        <div class="sub">{{ r.project }}{% if r.commit %} · commit <code>{{ r.commit }}</code>{% endif %}</div>
      </div>
    </div>
    <div class="meta">
      model <code>{{ r.model }}</code><br/>
      generated {{ r.generated_at[:19].replace("T"," ") }} UTC
    </div>
  </div>

  {% set fails = r.gate_fails() %}
  <div style="margin-bottom:18px">
    <span class="gate {{ 'fail' if fails else 'pass' }}">
      {{ '✕ QUALITY GATE FAILED' if fails else '✓ QUALITY GATE PASSED' }}
    </span>
  </div>

  <div class="cards">
    <div class="card"><div class="n">{{ r.risk_score }}</div><div class="l">Risk score</div></div>
    <div class="card"><div class="n">{{ total_findings }}</div><div class="l">Findings</div></div>
    <div class="card"><div class="n">{{ total_tests }}</div><div class="l">Suggested tests</div></div>
    <div class="card"><div class="n">{{ r.files|length }}</div><div class="l">Files reviewed</div></div>
  </div>

  <div class="bar">
    {% for s in severities %}{% if breakdown[s] %}<span style="flex:{{ breakdown[s] }};background:{{ colors[s] }}"></span>{% endif %}{% endfor %}
  </div>
  <div class="legend">
    {% for s in severities %}<span><span class="dot" style="background:{{ colors[s] }}"></span>{{ s }} · {{ breakdown[s] }}</span>{% endfor %}
  </div>

  <h2>Findings by file</h2>
  {% for f in r.files %}
  <div class="file">
    <div class="file-h">
      <span class="path">{{ f.path }}</span>
      <span class="fsum">{{ f.summary }}</span>
    </div>
    {% if f.findings %}
      {% for fd in f.findings %}
      <div class="finding">
        <div class="finding-h">
          <span class="sev" style="background:{{ colors[fd.severity.value] }}">{{ fd.severity.value }}</span>
          <span class="cat">{{ fd.category.value }}</span>
          {% if fd.line %}<span class="loc">line {{ fd.line }}</span>{% endif %}
          <div class="ftitle">{{ fd.title }}</div>
        </div>
        <div class="detail">{{ fd.detail }}</div>
        {% if fd.recommendation %}<div class="rec"><b>Fix:</b> {{ fd.recommendation }}</div>{% endif %}
      </div>
      {% endfor %}
    {% else %}
      <div class="empty">No defects flagged in this file.</div>
    {% endif %}

    {% if f.suggested_tests %}
    <div class="tests">
      <h2 style="margin:0 0 12px">Suggested tests</h2>
      {% for t in f.suggested_tests %}
      <div class="test">
        <div class="tt">{{ t.title }}</div>
        {% if t.rationale %}<div class="detail">{{ t.rationale }}</div>{% endif %}
        {% if t.scenario %}<pre>Scenario: {{ t.scenario.name }}
{% for step in t.scenario.steps %}  {{ step }}
{% endfor %}</pre>{% endif %}
        {% if t.pytest_skeleton %}<pre>{{ t.pytest_skeleton }}</pre>{% endif %}
      </div>
      {% endfor %}
    </div>
    {% endif %}
  </div>
  {% endfor %}

  <footer>
    Generated by <a href="https://github.com/Priya123z/ai-code-review">ai-code-review</a> ·
    built by <a href="https://priya123z.github.io">Priya Bhagoriya</a>
  </footer>
</div>
</body>
</html>
